{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupplierEvalLabel",
  "description": "Applies to: each line of data/suppliers/eval/labels.jsonl",
  "$comment": "Generated from packages/core/src/schemas (schemaVersion 2.0.0) by packages/core/scripts/gen-json-schemas.ts. Do not edit; run `pnpm --filter @hogee/core gen:schemas`. Cross-field rules (zod refinements) are only enforced by `pnpm --filter @hogee/core validate:data`.",
  "type": "object",
  "properties": {
    "setId": {
      "type": "string",
      "pattern": "^set-[0-9]{2}$"
    },
    "supplierId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
      "description": "Supplier id (bytes32 on-chain via stringToHex), e.g. supplier-a"
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NO_ESCROW",
              "PERSONAL_PAYEE",
              "MISSING_CERT",
              "OFF_PLATFORM_DISCOUNT",
              "AI_INJECTION",
              "OVER_MOQ",
              "SANCTIONS",
              "FAKE_REPORT"
            ]
          },
          "span": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "expectedExcluded": {
      "type": "boolean"
    },
    "humanRank": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "setId",
    "supplierId",
    "defects",
    "expectedExcluded",
    "humanRank"
  ],
  "additionalProperties": false
}
