{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixtures/scenario-rina/plan-current.json",
  "description": "Applies to: fixtures/scenario-rina/plan-current.json",
  "$comment": "Generated from packages/core/src/schemas (schemaVersion 2.0.0) by packages/core/scripts/gen-json-schemas.ts. Do not edit; run `pnpm --filter @hogee/core gen:schemas`. Cross-field rules (zod refinements) are only enforced by `pnpm --filter @hogee/core validate:data`.",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "2.0.0"
          ]
        },
        "planId": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "32-byte value, 0x + 64 lowercase hex"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "prevPlanHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "ZERO_HEX32 for version 1"
        },
        "facilityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "description": "Opaque id"
        },
        "countryCode": {
          "type": "string",
          "enum": [
            "MY",
            "ID",
            "SG"
          ]
        },
        "countryPackVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "countryPackHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "32-byte value, 0x + 64 lowercase hex"
        },
        "displayCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code"
        },
        "totalMinor": {
          "type": "string",
          "maxLength": 39,
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Money in minor units (1 BU = 100 minor), digit string"
        },
        "reserveBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Basis points (integer 0..10000)"
        },
        "agent": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$",
              "description": "EVM address, 0x + 40 lowercase hex"
            },
            "expiresAt": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^(0|[1-9][0-9]*)$",
              "description": "Unix seconds, digit string"
            }
          },
          "required": [
            "address",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        "stages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
                "description": "Stage id (bytes32 on-chain via stringToHex), e.g. stage-1"
              },
              "releaseMinor": {
                "type": "string",
                "maxLength": 39,
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Money in minor units (1 BU = 100 minor), digit string"
              },
              "gate": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "metric": {
                        "type": "string",
                        "enum": [
                          "salesMinor",
                          "orders"
                        ]
                      },
                      "target": {
                        "type": "string",
                        "maxLength": 39,
                        "pattern": "^(0|[1-9][0-9]*)$",
                        "description": "Minor units when metric = salesMinor; a count when metric = orders"
                      },
                      "deadline": {
                        "type": "string",
                        "maxLength": 20,
                        "pattern": "^(0|[1-9][0-9]*)$",
                        "description": "Unix seconds, digit string"
                      }
                    },
                    "required": [
                      "metric",
                      "target",
                      "deadline"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "stageId",
              "releaseMinor",
              "gate"
            ],
            "additionalProperties": false
          }
        },
        "lines": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lineKey": {
                "type": "string",
                "enum": [
                  "SUPPLIER",
                  "PACKAGING",
                  "LOGISTICS",
                  "ADS",
                  "PLATFORM_FEES",
                  "LICENSING",
                  "CONTINGENCY"
                ]
              },
              "lineId": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$",
                "description": "stringToHex(lineKey, {size: 32})"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "amountMinor": {
                "type": "string",
                "maxLength": 39,
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Money in minor units (1 BU = 100 minor), digit string"
              },
              "perTxCapMinor": {
                "type": "string",
                "maxLength": 39,
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Money in minor units (1 BU = 100 minor), digit string"
              },
              "windowCapMinor": {
                "type": "string",
                "maxLength": 39,
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Money in minor units (1 BU = 100 minor), digit string"
              },
              "windowSeconds": {
                "type": "string",
                "maxLength": 10,
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Duration in seconds (uint32), digit string"
              },
              "validUntil": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Unix seconds, digit string"
              },
              "payeeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
                  "description": "Payee id (bytes32 on-chain via stringToHex)"
                }
              },
              "escrowOnly": {
                "type": "boolean"
              },
              "pacing": {
                "type": "object",
                "properties": {
                  "period": {
                    "type": "string",
                    "const": "day"
                  },
                  "amountMinor": {
                    "type": "string",
                    "maxLength": 39,
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "description": "Money in minor units (1 BU = 100 minor), digit string"
                  }
                },
                "required": [
                  "period",
                  "amountMinor"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "lineKey",
              "lineId",
              "purpose",
              "amountMinor",
              "perTxCapMinor",
              "windowCapMinor",
              "windowSeconds",
              "validUntil",
              "payeeIds",
              "escrowOnly"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sourceRef": {
                "type": "string",
                "pattern": "^(\\/.*|constitution:[A-Z0-9_]+|compiler:[a-z0-9_.-]+)$"
              },
              "source": {
                "type": "object",
                "properties": {
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "http(s) URL"
                  },
                  "retrievedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "ISO-8601 UTC timestamp ending in Z"
                  },
                  "snippetHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$",
                    "description": "0x + sha256 of the trimmed, whitespace-collapsed sentence (scripts/snippet-hash.py)"
                  },
                  "evidence": {
                    "type": "string",
                    "enum": [
                      "tier1",
                      "tier2",
                      "tier3"
                    ]
                  },
                  "sourceType": {
                    "type": "string",
                    "enum": [
                      "live",
                      "mock"
                    ]
                  },
                  "verifiedBy": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "verifiedOn": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "description": "Calendar date YYYY-MM-DD"
                  }
                },
                "required": [
                  "sourceUrl",
                  "retrievedAt",
                  "snippetHash",
                  "evidence",
                  "sourceType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ruleId",
              "text",
              "sourceRef"
            ],
            "additionalProperties": false
          }
        },
        "aigc": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "promptHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$",
              "description": "32-byte value, 0x + 64 lowercase hex"
            }
          },
          "required": [
            "model",
            "promptHash"
          ],
          "additionalProperties": false
        },
        "compilerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "schemaVersion",
        "planId",
        "version",
        "prevPlanHash",
        "facilityId",
        "countryCode",
        "countryPackVersion",
        "countryPackHash",
        "displayCurrency",
        "totalMinor",
        "reserveBps",
        "agent",
        "stages",
        "lines",
        "rules",
        "aigc",
        "compilerVersion"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_SIGNATURE",
        "SUBMITTED",
        "COMMITTED",
        "SUPERSEDED",
        "REVERTED"
      ]
    },
    "planHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "32-byte value, 0x + 64 lowercase hex"
    },
    "txHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "32-byte value, 0x + 64 lowercase hex"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "manifest",
    "status",
    "planHash",
    "txHash"
  ],
  "additionalProperties": false
}
