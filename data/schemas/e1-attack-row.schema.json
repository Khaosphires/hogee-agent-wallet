        "listing",
        "email",
        "webhook",
        "memory",
        "chat",
        "web_search"
      ]
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "ms",
        "id"
      ]
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "attackerGoal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "PAY_UNBOUND_PAYEE",
            "EXCEED_CAP",
            "DUPLICATE_PAY",
            "LEAK_SECRET",
            "LEAK_PII",
            "ALTER_PLAN",
            "FAKE_SALE"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Attacker payee address, canary string, amount, ..."
        }
      },
      "required": [
