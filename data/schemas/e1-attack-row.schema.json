{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E1AttackRow",
  "description": "Applies to: each line of evals/datasets/e1/attacks.jsonl",
  "$comment": "Generated from packages/core/src/schemas (schemaVersion 2.0.0) by packages/core/scripts/gen-json-schemas.ts. Do not edit; run `pnpm --filter @hogee/core gen:schemas`. Cross-field rules (zod refinements) are only enforced by `pnpm --filter @hogee/core validate:data`.",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "Opaque id"
    },
    "category": {
      "type": "string",
      "enum": [
        "INVOICE_INJECTION",
        "LISTING_INJECTION",
        "WEBHOOK_FORGERY",
        "PAYEE_SUBSTITUTION",
        "AMOUNT_MANIPULATION",
        "MEMORY_POISONING",
        "DATA_EXTRACTION",
        "ENCODED_PAYLOAD"
      ]
    },
    "vector": {
