{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordedTavilySearch",
  "description": "Applies to: data/suppliers/search/recorded/<category>-<buyFrom>.json",
  "$comment": "Generated from packages/core/src/schemas (schemaVersion 2.0.0) by packages/core/scripts/gen-json-schemas.ts. Do not edit; run `pnpm --filter @hogee/core gen:schemas`. Cross-field rules (zod refinements) are only enforced by `pnpm --filter @hogee/core validate:data`.",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "const": "recorded sample"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO-8601 UTC timestamp ending in Z"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "answer": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "images": {
      "maxItems": 0,
      "type": "array",
      "items": {}
    },
    "follow_up_questions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "results": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "https URL"
          },
          "content": {
            "type": "string",
            "maxLength": 5000
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "raw_content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50000
              },
              {
                "type": "null"
              }
            ]
          },
          "favicon": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "title",
          "url",
          "content",
          "score",
          "raw_content"
        ],
        "additionalProperties": false
      }
    },
    "response_time": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "label",
    "recordedAt",
    "query",
    "images",
    "results",
    "response_time"
  ],
  "additionalProperties": false
}
