# Names only (project.md §18.3). Copy to .env (or .env.local) and fill locally.
# Never commit real values; never paste keys into prompts. Secrets live ONLY in .env / .env.local.

# chain
CHAIN=local                     # local | sepolia | fisco
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=       # second provider for viem fallback()
ETHERSCAN_API_KEY=
DEPLOYER_PRIVATE_KEY=           # dev only; Sepolia deployer is held by P1
AGENT_PRIVATE_KEY_LOOP=         # session key for loop-1 (expires); worker host only
AGENT_PRIVATE_KEY_FINAL=        # session key for final-1
ORACLE_PRIVATE_KEY_LOOP=
ORACLE_PRIVATE_KEY_FINAL=
LENDER_PRIVATE_KEY_LOOP=        # demo loan officer (server-held, labelled "demo")
LENDER_PRIVATE_KEY_FINAL=
RELAYER_PRIVATE_KEY_LOOP=       # submits founder/lender-signed txs; no authority of its own
RELAYER_PRIVATE_KEY_FINAL=
LOOP_DEPLOYMENT_ID=loop-1       # autonomous-loop deployment (never redeployed)
FINAL_DEPLOYMENT_ID=final-1     # scripted tasks + red-team deployment
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
MAX_FEE_GWEI=                   # loop skips ticks above this
RPC_POLLING_MS=12000
CHAIN_TAG=                      # EIP-712 chainTag

# models
MODEL_PROVIDER=anthropic        # anthropic | deepseek | qwen | ollama
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=              # Qwen (Singapore endpoint)
OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=claude-sonnet-5-5
READER_MODEL=claude-haiku-5-5
JUDGE_MODEL=

# rails (test mode only)
XENDIT_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# data
BNM_API_BASE=https://api.bnm.gov.my/public
GLEIF_API_BASE=https://api.gleif.org/api/v1

# infra
DATABASE_URL=postgres://hogee:hogee@localhost:5432/hogee
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
DEMO_TIMELOCK_SECONDS=120
MOCK_API=0                      # 1 = packages/api-mock (fixtures)
REPLAY=                         # <runId> = serve a recorded evidence bundle (offline demo)
DEMO_MODE=0                     # 1 = enable /api/demo/* and /api/eval/* routes
OFFICER_TOKEN=                  # operator secret, >= 32 chars, required to switch to the officer persona; unset = nobody can
PERSONA_COOKIE_SECRET=          # HMAC key for the persona cookie; required when DEMO_MODE=1 (openssl rand -hex 32)
HOGEE_ALLOWED_HOSTS=            # Host/Origin allow-list for /api; default localhost:3000,127.0.0.1:3000
PAYOUT_RAIL=xendit              # xendit | mock (evals always use mock)
