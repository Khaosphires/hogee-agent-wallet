    "registrations": [
      {
        "code": "ACRA_BUSINESS",
        "entityTypes": [
          "sg_sole_prop",
          "sg_partnership"
        ],
        "requirement": {
          "value": "Register the business and its business name with ACRA through BizFile+ before carrying on business in Singapore (Business Names Registration Act 2014 s 5(1)): a business name application, then registration for 1 or 3 years, renewed before expiry. Exempt only when trading under the owner's own full NRIC name (or all partners' full names); an online shop under any other name must register. Self-employed owners must be up to date with MediSave before applying. A UEN is also needed to import goods (Customs account) and to register with SFA as an importer of food contact articles.",
          "sourceUrl": "https://sso.agc.gov.sg/Act/BNRA2014?ProvIds=pr5-",
          "retrievedAt": "2026-10-18T13:58:25Z",
          "snippetHash": "0x49d28389cb5dc0bdbe864a730deccac9362c8878ca6cb839e7eb9a4ced3b915b",
          "evidence": "tier1",
          "sourceType": "live"
        },
