    "taxIds": [
      {
        "code": "ACRA_BUSINESS",
        "rule": {
          "value": "The UEN issued on ACRA registration identifies the business in its dealings with government agencies, including IRAS for GST and Singapore Customs for import permits. A sole proprietor's or partner's business income is taxed under the individual's own NRIC or FIN, not the UEN. A GST registration number may be the UEN or a separate M-prefixed number.",
          "sourceUrl": "https://www.gobusiness.gov.sg/resources/start-up-guide/register-your-business",
          "retrievedAt": "2026-10-18T13:56:56Z",
          "snippetHash": "0x25e035b185dc9c79b83671de7c175a837136b1e95c90ea925501748b5bddf342",
          "evidence": "tier1",
          "sourceType": "live"
        }
      },
      {
        "code": "ACRA_PTE_LTD",
        "rule": {
          "value": "The company's UEN, issued on incorporation, is its IRAS tax reference number (Corporate Income Tax and GST) and its identifier with Singapore Customs.",
